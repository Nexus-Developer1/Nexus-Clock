APP_NAME="Nexus Tempos"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://infra.nexus-solutions.pt:9443/tempos

# Chave desta aplicação na tabela `aplicacoes` do portal, e para onde vai quem não tem acesso.
APP_CHAVE=tempos
PORTAL_URL=https://infra.nexus-solutions.pt:9443/portal

APP_LOCALE=pt_PT
APP_FALLBACK_LOCALE=pt_PT
APP_FAKER_LOCALE=pt_PT
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# A MESMA base de dados da Nexus Infra (tabelas próprias, registo de migrações `migrations_tempos`).
# NUNCA correr migrate:fresh / db:wipe contra ela — a aplicação recusa-se (ver AppServiceProvider).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nexus_ops
DB_USERNAME=
DB_PASSWORD=
SUITE_CONNECTION=pgsql

# Sessão partilhada com a suite: estas definições têm de coincidir com as do portal.
SESSION_DRIVER=redis
SESSION_STORE=sessao
SESSION_SERIALIZATION=php
SESSION_COOKIE=nexus-infra-session
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null
REDIS_PREFIX=nexus-infra-database-

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Quem, além de ser administrador, pode reabrir um mês fechado (emails separados por vírgula).
TEMPOS_PODE_REABRIR=suporte@nxs.pt
TEMPOS_FUSO=Europe/Lisbon
TEMPOS_HORAS_SEMANA_MINIMAS=35

# Emails pela conta Suporte@nxs.pt via Microsoft Graph (as mesmas credenciais da Nexus Infra).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responder@nexus.pt"
MAIL_FROM_NAME="${APP_NAME}"
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER=Suporte@nxs.pt
